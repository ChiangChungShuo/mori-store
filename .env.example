# 網站正式網址（用於 SEO metadata、sitemap、canonical、JSON-LD）；未設定時退回 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# 超商門市電子地圖（綠界 ECPay）。未設定時預設用綠界「測試」地圖與 C2C 測試商店代號 2000933
# （2000132 是 B2C 測試代號、沒有開通超商店到店，會出現「找不到加密金鑰」）。
# 正式上線請填自己申請的綠界商店代號並改用正式網址。
# 正式地圖網址：https://logistics.ecpay.com.tw/Express/map
NEXT_PUBLIC_ECPAY_MAP_URL=
NEXT_PUBLIC_ECPAY_MERCHANT_ID=

# Supabase Dashboard > Connect > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Dashboard > Settings > API Keys > Publishable key (browser-safe with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Dashboard > Settings > API Keys > Secret key (server-only; never commit)
SUPABASE_SECRET_KEY=

# 正式 Email 驗證碼請在 Supabase Dashboard > Authentication > Emails > SMTP Settings
# 設定自訂 SMTP；本機 MORI_E2E_FIXTURES=1 使用固定驗證碼 123456，不會寄信。

# 銀行匯款資訊（僅在伺服器讀取；請勿使用客戶個人網銀密碼或驗證碼）
MORI_BANK_NAME=
MORI_BANK_CODE=
MORI_BANK_ACCOUNT=
MORI_BANK_ACCOUNT_NAME=

# 訂單通知信（Resend）。未設定 RESEND_API_KEY 時不寄信、也不會報錯。
# MORI_EMAIL_FROM 未設定時預設用 Resend 共用寄件地址 onboarding@resend.dev
# （未驗證網域前只會寄到你 Resend 帳號本人的信箱；驗證網域後改成自己網域的地址）。
# MORI_ORDER_BCC 可填店家信箱，接到每筆訂單的副本通知。
RESEND_API_KEY=
MORI_EMAIL_FROM=
MORI_ORDER_BCC=

# Optional Playwright live mode. Leave HAS_LIVE_DATA=0 for local deterministic fixtures.
HAS_LIVE_DATA=0
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_GUEST_VARIANT_ID=
E2E_MEMBER_VARIANT_ID=
